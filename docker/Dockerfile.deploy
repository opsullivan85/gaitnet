# syntax=docker/dockerfile:1
# The planner for a real robot, on the x86 machine next to it: gaitnet-core and gaitnet-ros1
# on CPU torch, talking to the robot's rosbridge server. No ROS, no Isaac. Bundles come from a
# mounted directory (compose mounts data/bundles at /bundles):
#
#   docker compose -f docker/compose.yaml run --rm deploy --bundle /bundles/policy.pt --host <robot>
#
# See packages/gaitnet-ros1/README.md. For a GPU planner, build with
# --build-arg TORCH_INDEX=https://download.pytorch.org/whl/cu128 and run with --device cuda.
FROM python:3.12-slim

ARG TORCH_INDEX=https://download.pytorch.org/whl/cpu
# the training image's torch minor version, so bundles load the same
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install "torch==2.11.*" --index-url ${TORCH_INDEX}
# for VS Code remote-attach debugging (docker/README.md); off the default index, unlike torch
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install debugpy

# Editable, and compose bind-mounts the checkout over /workspace/gaitnet (as it does for
# `sim`), so code changes apply without a rebuild and debugger breakpoints match real paths.
# Both at once, so gaitnet-ros1's gaitnet-core requirement is the local one.
WORKDIR /workspace/gaitnet
COPY packages/gaitnet-core packages/gaitnet-core
COPY packages/gaitnet-ros1 packages/gaitnet-ros1
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -e packages/gaitnet-core -e packages/gaitnet-ros1

ENTRYPOINT ["python", "-m", "gaitnet_ros1.run"]
